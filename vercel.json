{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "student-ui": {
      "root": "frontend/student-ui",
      "framework": "vite",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    },
    "portals": {
      "root": ".",
      "buildCommand": "node scripts/build-all-portals.mjs",
      "outputDirectory": "dist-portals",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend",
        "path": "/:path*"
      }
    },
    {
      "source": "/student-ui/:path*",
      "destination": {
        "service": "student-ui",
        "path": "/:path*"
      }
    },
    {
      "source": "/student-ui",
      "destination": {
        "service": "student-ui",
        "path": "/"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "portals"
      }
    }
  ]
}
